# Copy this file to .env and fill in your Supabase project values.
# These are exposed to the client bundle (EXPO_PUBLIC_*) — only the publishable (anon) key belongs here, never a service role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google sign-in (Google Cloud Console -> Credentials). The Web client ID is what Supabase verifies.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
